{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/main/crates/emmylua_code_analysis/resources/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "requirePattern": ["lua/?.lua", "lua/?/init.lua"]
  },
  "workspace": {
    "library": [
      {
        "path": "$VIMRUNTIME",
        "ignoreGlobs": ["**/lua/vim/_core/editor.lua"]
      },
      {
        "path": "~/.local/share/nvim/site/pack/core/opt",
        "ignoreGlobs": [
          "**/scripts/**",
          "**/tests/**",
          "**/spec/**",
          "**/*_spec.lua"
        ]
      }
    ]
  }
}
